---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  shortname: string;
  title: string;
}

const { shortname, title } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
const filename = ['png', 'jpg', 'webp'].map((extension) => `${shortname}.${extension}`)
  .find((name) => existsSync(resolve('public/images/systems', name)));
---

{filename && (
  <figure class="system-screenshot">
    <img src={`${base}images/systems/${filename}`} alt={`${title} running in ArcadeDuck`} loading="lazy" />
    <figcaption>{title}</figcaption>
  </figure>
)}

<style>
  .system-screenshot { margin: 20px 0; }
  .system-screenshot img {
    display: block;
    width: 100%;
    max-height: 360px;
    object-fit: contain;
    background: var(--bg);
    border-radius: 10px;
  }
  .system-screenshot figcaption { margin-top: 8px; color: var(--text-muted); font-size: 0.9rem; }
</style>
