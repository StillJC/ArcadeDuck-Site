---
import SiteLayout from '../../layouts/SiteLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<SiteLayout
  title="Documentation | ArcadeDuck"
  description="ArcadeDuck documentation for installation, building from source, game setup, controls, configuration, and troubleshooting."
>
  <section class="page-hero">
    <p class="eyebrow">Help</p>
    <h1>Documentation</h1>
    <p class="page-description">
      Installation, building from source, game setup, controls, configuration,
      and troubleshooting.
    </p>
  </section>

  <section class="systems-status-section setup-video-section">
    <div class="systems-group-heading">
      <div>
        <p class="eyebrow">Getting Started</p>
        <h2>ArcadeDuck introduction and setup video</h2>
      </div>

      <p>
        Watch the setup walkthrough directly here, or open it separately on
        YouTube.
      </p>
    </div>

    <div class="setup-video-frame">
      <iframe
        src="https://www.youtube.com/embed/cFTN-Xjj2PQ"
        title="ArcadeDuck introduction and setup video"
        loading="lazy"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen
      ></iframe>
    </div>

    <p class="setup-video-link">
      <a
        href="https://www.youtube.com/watch?v=cFTN-Xjj2PQ"
        target="_blank"
        rel="noopener noreferrer"
      >
        Open the setup video on YouTube &rarr;
      </a>
    </p>
  </section>
  <section class="systems-status-section">
    <div class="systems-group-heading">
      <div>
        <p class="eyebrow">User Documentation</p>
        <h2>ArcadeDuck user guides</h2>
      </div>

      <p>
        Launch ArcadeDuck from frontends and scripts, and configure native MAME
        cheat packages for supported arcade sets.
      </p>
    </div>

    <div class="planned-system-grid">
      <article class="planned-system-card">
        <span class="hardware-manufacturer">Frontends &amp; Cabinets</span>
        <h3>Command-line launching</h3>
        <p>
          Direct launching, fullscreen and no-GUI modes, merged-set clone
          selection, ROM-set layouts, and the complete command-line reference.
        </p>
        <p>
          <a href={`${base}docs/command-line/`}>Open command-line guide &rarr;</a>
        </p>
      </article>
      <article class="planned-system-card">
        <span class="hardware-manufacturer">MAME XML</span>
        <h3>Native MAME cheats</h3>
        <p>
          Set up <code>cheat.7z</code> or loose shortname XML files, use cheats
          from the Qt or fullscreen interface, and troubleshoot loading.
        </p>
        <p>
          <a href={`${base}docs/cheats/`}>Open MAME cheat guide &rarr;</a>
        </p>
      </article>
    </div>
  </section>
  <section class="systems-status-section">
    <div class="systems-group-heading">
      <div>
        <p class="eyebrow">Developer Documentation</p>
        <h2>Build ArcadeDuck on Windows</h2>
      </div>
    </div>

    <div class="planned-system-grid">
      <article class="planned-system-card">
        <span class="hardware-manufacturer">Windows x64</span>
        <h3>Building from source</h3>
        <p>
          Clone the source, install the validated dependency package, and build
          ArcadeDuck with Visual Studio/MSBuild.
        </p>
        <p>
          <a href={`${base}docs/building/`}>Open build instructions &rarr;</a>
        </p>
      </article>
    </div>
  </section>
  <style>
    .setup-video-section .systems-group-heading {
      display: block;
      margin-bottom: 30px;
    }

    .setup-video-section .systems-group-heading h2 {
      max-width: 900px;
      margin-bottom: 16px;
    }

    .setup-video-section .systems-group-heading > p {
      max-width: 720px;
      margin: 0;
    }

    .setup-video-section .setup-video-heading {
      display: block;
      max-width: 900px;
      margin-bottom: 30px;
    }

    .setup-video-section .setup-video-heading h2 {
      margin-bottom: 16px;
    }

    .setup-video-section .setup-video-heading > p:last-child {
      max-width: 720px;
      margin: 0;
      color: var(--text-muted);
      line-height: 1.65;
    }

    .setup-video-frame {
      width: 100%;
      max-width: 1100px;
      aspect-ratio: 16 / 9;
      margin-top: 1.5rem;
    }

    .setup-video-frame iframe {
      width: 100%;
      height: 100%;
      border: 0;
      border-radius: 14px;
    }

    .setup-video-link {
      margin-top: 1rem;
    }
  </style>
</SiteLayout>
