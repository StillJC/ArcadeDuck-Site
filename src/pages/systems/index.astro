---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SystemScreenshot from '../../components/SystemScreenshot.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<SiteLayout
  title="Systems | ArcadeDuck"
  description="Arcade hardware supported and under development for ArcadeDuck."
>
  <section class="page-hero systems-hero">
    <p class="eyebrow">Hardware Support</p>

    <h1>Arcade systems</h1>

    <p class="page-description">
      ArcadeDuck is focused on PlayStation-derived and related arcade hardware.
      This page tracks systems that are supported and currently under development.
    </p>
  </section>

  <section class="systems-status-section">
    <div class="systems-group-heading">
      <div>
        <p class="eyebrow">Current Support</p>
        <h2>Supported</h2>
      </div>

      <p>
        Hardware with established ArcadeDuck support and playable game coverage.
      </p>
    </div>

    <div class="systems-list">
      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Konami</span>
            <h3>Konami GV</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="simpbowl" title="The Simpsons Bowling" />

        <p>
          PlayStation-derived arcade platform using CD-ROM media with
          board-specific controls and daughterboard hardware.
        </p>

        <div class="hardware-tags">
          <span>CD-ROM</span>
          <span>SCSI</span>
          <span>Trackball</span>
          <span>Lightgun</span>
          <span>Specialized Controls</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Konami</span>
            <h3>Konami GQ</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="cryptklr" title="Crypt Killer" />

        <p>
          PlayStation-derived Konami hardware using SCSI hard-disk storage,
          expanded system memory, and dedicated Konami sound hardware.
        </p>

        <div class="hardware-tags">
          <span>HDD</span>
          <span>SCSI</span>
          <span>Lightgun</span>
          <span>Expanded RAM</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Namco</span>
            <h3>Namco System 11</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="tekken2" title="Tekken 2" />

        <p>
          Namco's first major PlayStation-derived arcade platform with
          board-specific ROM, input, sound, peripheral, and output support.
        </p>

        <div class="hardware-tags">
          <span>ROM</span>
          <span>Namco C76</span>
          <span>Namco C352</span>
          <span>Specialized Controls</span>
          <span>External Outputs</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Namco</span>
            <h3>Namco System 12</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="tektagt" title="Tekken Tag Tournament" />

        <p>
          Successor to System 11 with expanded PlayStation-derived hardware,
          JVS cabinet controls, and optional Cyber Lead LED hardware emulation.
        </p>

        <div class="hardware-tags">
          <span>ROM</span>
          <span>Namco C352</span>
          <span>JVS</span>
          <span>Cyber Lead LED</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Capcom</span>
            <h3>Capcom ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="sfex" title="Street Fighter EX" />

        <p>Capcom's Sony ZN-1 hardware based on the COH-1000C board.</p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1000C</span>
          <span>QSound</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Capcom</span>
            <h3>Capcom ZN-2</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="rvschool" title="Rival Schools: United By Fate" />

        <p>Capcom's second-generation Sony ZN hardware based on the COH-3002C board.</p>

        <div class="hardware-tags">
          <span>ZN-2</span>
          <span>COH-3002C</span>
          <span>QSound</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Taito</span>
            <h3>Taito G-Net</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="raycris" title="RayCrisis" />

        <p>
          Taito's removable-media PlayStation-derived platform, including
          COH-3002T and COH-1002T hardware variants.
        </p>

        <div class="hardware-tags">
          <span>ZN-2 Family</span>
          <span>ZN-1 Family</span>
          <span>COH-3002T</span>
          <span>COH-1002T</span>
          <span>PC Card / CompactFlash</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Taito</span>
            <h3>Taito FX-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="gdarius2" title="G-Darius Ver.2" />

        <p>Taito's ZN-1-derived FX-1 hardware based on COH-1000T / COH-1002T.</p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1000T</span>
          <span>COH-1002T</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Acclaim</span>
            <h3>Acclaim ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="nbajamex" title="NBA Jam Extreme" />

        <p>Acclaim's Sony ZN-1 implementation based on the COH-1000A board.</p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1000A</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Atari / Time Warner</span>
            <h3>Time Warner ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="primrag2" title="Primal Rage II" />

        <p>
          Atari / Time Warner's Sony ZN-1 implementation based on the COH-1000W board.
        </p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1000W</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Atlus</span>
            <h3>Atlus ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="hvnsgate" title="Heaven's Gate" />

        <p>Atlus's Sony ZN-1 implementation based on the COH-1001L board.</p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1001L</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Video System</span>
            <h3>Video System ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="aerofgts" title="Aero Fighters Special" />

        <p>Video System's Sony ZN-1 implementation based on the COH-1002V board.</p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1002V</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Eighting / Raizing</span>
            <h3>Eighting / Raizing ZN-1</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="bldyror2" title="Bloody Roar 2" />

        <p>
          Eighting / Raizing's Sony ZN-1 implementation based on the COH-1002E board.
        </p>

        <div class="hardware-tags">
          <span>ZN-1</span>
          <span>COH-1002E</span>
        </div>
      </article>

      <article class="hardware-card supported-hardware">
        <div class="hardware-card-header">
          <div>
            <span class="hardware-manufacturer">Tecmo</span>
            <h3>Tecmo TPS System</h3>
          </div>
          <span class="status-badge supported">Supported</span>
        </div>

        <SystemScreenshot shortname="doapp" title="Dead Or Alive ++" />

        <p>Tecmo's PlayStation-derived TPS hardware based on the COH-1002M board.</p>

        <div class="hardware-tags">
          <span>ZN-1 Family</span>
          <span>COH-1002M</span>
        </div>
      </article>
    </div>
  </section>
<section class="systems-status-section planned-systems-section">
    <div class="systems-group-heading">
      <div>
        <p class="eyebrow">Active Development</p>
        <h2>In Development</h2>
      </div>

      <p>
        Arcade hardware currently being implemented. Order does not represent
        implementation priority.
      </p>
    </div>

    <div class="planned-system-grid">

      <article class="planned-system-card">
        <span class="hardware-manufacturer">Namco</span>
        <h3>System 10</h3>
        <span class="status-badge development">In Development</span>
        <p>
          Later Namco PlayStation-derived hardware with additional storage
          and protection requirements.
        </p>
      </article>

      <article class="planned-system-card">
        <span class="hardware-manufacturer">Konami</span>
        <h3>System 573</h3>
        <span class="status-badge development">In Development</span>
        <p>
          Konami PlayStation-derived arcade hardware used across a wide range
          of cabinet and peripheral configurations.
        </p>
      </article>

      <article class="planned-system-card">
        <span class="hardware-manufacturer">Konami</span>
        <h3>Twinkle</h3>
        <span class="status-badge development">In Development</span>
        <p>
          Specialized Konami arcade platform retained as its own hardware family.
        </p>
      </article>

    </div>
  </section>


  <section class="systems-note">
    <div><p class="eyebrow">Next Steps</p><h2>Games, setup, and development</h2></div>
    <p><a href={`${base}games/`}>Browse games</a>, <a href={`${base}docs/setup/`}>check BIOS requirements</a>, or <a href={`${base}development/`}>follow the development roadmap</a>.</p>
  </section>
</SiteLayout>
