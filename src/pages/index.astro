---
import SiteLayout from '../layouts/SiteLayout.astro';

const base = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---

<SiteLayout title="ArcadeDuck">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">Arcade Emulation</p>

      <h1>ArcadeDuck</h1>

      <p class="page-description">
        PlayStation roots. Arcade cabinet priorities.
      </p>

      <p class="hero-description">
        Bring PlayStation-derived arcade games to Windows, with controls,
        devices, and settings built around the original machines.
      </p>

      <div class="hero-actions">
        <a class="button button-primary" href="https://github.com/StillJC/ArcadeDuck/releases" target="_blank" rel="noreferrer">
          Download
        </a>

        <a class="button button-secondary" href={`${base}docs/setup/`}>
          Setup Guide
        </a>

        <a class="button button-secondary" href={`${base}games/`}>
          Supported Games
        </a>
      </div>
    </div>

    <div class="hero-art">
      <img
        src={`${base}images/brand/arcadeduck-wallpaper.png`}
        alt="ArcadeDuck artwork"
      />
    </div>
  </section>

  <section class="status-strip" aria-label="ArcadeDuck project status">
    <div class="status-item">
      <span class="status-label">Platform</span>
      <strong>Windows x64</strong>
    </div>

    <div class="status-item">
      <span class="status-label">Development</span>
      <strong class="status-active">Active</strong>
    </div>

    <div class="status-item">
      <span class="status-label">Focus</span>
      <strong>Arcade Hardware</strong>
    </div>

    <div class="status-item">
      <span class="status-label">License</span>
      <strong>GPL-3.0</strong>
    </div>
  </section>

  <section class="home-section arcade-focus-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Designed for the Cabinet</p>
        <h2>Built for arcade hardware</h2>
      </div>
    </div>

    <div class="feature-grid">
      <article class="feature-card">
        <span class="feature-number">01</span>
        <h3>Arcade media</h3>
        <p>
          Built around arcade ROM sets, CHDs, board-specific BIOS files,
          and the storage formats used by the original hardware.
        </p>
      </article>

      <article class="feature-card">
        <span class="feature-number">02</span>
        <h3>Cabinet controls</h3>
        <p>
          Dedicated support for coin, start, test, service, multiplayer
          controls, and game-specific control layouts.
        </p>
      </article>

      <article class="feature-card">
        <span class="feature-number">03</span>
        <h3>Arcade devices</h3>
        <p>
          Support for joysticks, trackballs, lightguns, specialized
          controllers, and multi-device Raw Input.
        </p>
      </article>

      <article class="feature-card">
        <span class="feature-number">04</span>
        <h3>Per-game settings</h3>
        <p>
          Save game-specific controls and configuration so each title can
          launch with the hardware setup it actually needs.
        </p>
      </article>
    </div>
  </section>
  <section class="home-section explore-section" aria-labelledby="explore-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Explore ArcadeDuck</p>
        <h2 id="explore-heading">Your next stop.</h2>
      </div>
    </div>

    <div class="explore-grid">
      <a class="explore-card" href={`${base}games/`}>
        <span class="eyebrow">Game Database</span>
        <h3>Find your game <span aria-hidden="true">&rarr;</span></h3>
        <p>Search by title, hardware, or ROM shortname.</p>
      </a>
      <a class="explore-card" href={`${base}systems/`}>
        <span class="eyebrow">Hardware</span>
        <h3>Explore the machines <span aria-hidden="true">&rarr;</span></h3>
        <p>See the arcade boards behind the games and their support status.</p>
      </a>
      <a class="explore-card" href={`${base}docs/setup/`}>
        <span class="eyebrow">Getting Started</span>
        <h3>Set up your cabinet <span aria-hidden="true">&rarr;</span></h3>
        <p>Prepare BIOS files, add games, and configure your controls.</p>
      </a>
    </div>

    <div class="home-story">
      <p>This was supposed to fix a bowling game. Things got out of hand.</p>
      <a href={`${base}about/`}>Read the story &rarr;</a>
      <a href={`${base}development/`}>Follow development &rarr;</a>
    </div>
  </section>
  <style>
    .home-hero { min-height: 460px; padding: 48px 0; gap: 40px; }
    .home-hero .page-description { color: var(--text); font-weight: 650; }
    .hero-description { margin: 18px 0 0; color: var(--text-muted); line-height: 1.7; }
    .status-strip { margin-bottom: 56px; }
    .home-section { padding-bottom: 56px; }
    .feature-number { margin-bottom: 22px; }
    .explore-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
    .explore-card {
      display: block;
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: 14px;
      background: linear-gradient(145deg, rgba(156, 92, 255, 0.12), var(--bg-raised));
      text-decoration: none;
    }
    .explore-card:hover { border-color: var(--purple-bright); }
    .explore-card:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 4px; }
    .explore-card .eyebrow { display: block; }
    .explore-card h3 { margin: 0 0 14px; font-size: 1.35rem; }
    .explore-card h3 span { color: var(--purple-bright); }
    .explore-card p { margin: 0; color: var(--text-muted); line-height: 1.65; }
    .home-story { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); }
    .home-story p { flex: 1 1 320px; margin: 0; color: var(--text-muted); line-height: 1.65; }
    .home-story a { color: var(--purple-bright); }
    @media (max-width: 1000px) {
      .home-hero { min-height: 0; gap: 28px; }
    }
    @media (max-width: 700px) {
      .explore-grid { grid-template-columns: 1fr; }
      .home-hero { padding: 36px 0; }
      .status-strip { margin-bottom: 40px; }
      .home-section { padding-bottom: 40px; }
    }
  </style>
</SiteLayout>
