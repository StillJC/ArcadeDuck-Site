---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Download | ArcadeDuck">
  <section class="page-hero">
    <p class="eyebrow">ArcadeDuck</p>
    <h1>Download</h1>

    <p class="page-description">
      Download the latest public ArcadeDuck build from the official GitHub releases page.
    </p>
  </section>

  <section class="placeholder-panel">
    <h2>ArcadeDuck Releases</h2>

    <p>
      Current builds, release notes, and downloadable packages are published
      through the ArcadeDuck GitHub repository.
    </p>

    <p>
      <a
        class="button button-primary"
        href="https://github.com/StillJC/ArcadeDuck/releases"
        target="_blank"
        rel="noreferrer"
      >
        View ArcadeDuck Releases
      </a>
    </p>
  </section>
</SiteLayout>